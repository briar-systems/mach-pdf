# the one failure type every pdf module reports

use ttf: font;
use std.allocator;
use std.types.error.err;

# why a pdf operation did not complete
#
# the first case is the zero default, so a zero-initialized `err[Error]` reads
# as a refused allocation.
# ---
# exhausted:   an allocator refused a request
# invalid:     an argument outside the contract, such as a reference to an
#              object number the document does not hold or a number with no
#              pdf spelling
# unset:       the object number allocated but never given a value at save
# reservation: a value wider than the reservation it fills
# encoder:     a filter with no encoder over stream data that is not encoded
# codec:       a filter's encoder failed with its own code
# base:        an incremental save with no prior revision to append to
# font:        a font program mach-font refused, with its reason
# glyph:       text holds this code point, which the font has no glyph for
pub tag Error: u8 {
    exhausted;
    invalid;
    unset: u32;
    reservation;
    encoder;
    codec: i64;
    base;
    font:  ttf.FontError;
    glyph: u32;
}

# the pdf failure for an allocator refusal
# ---
# cause: the allocator's error
# ret:   `invalid` for a contract violation, `exhausted` otherwise
pub fun from_allocator(cause: allocator.Error) Error {
    if (sel cause.invalid) { ret Error.invalid{}; }
    ret Error.exhausted{};
}

# the first failure among outcomes, for steps that may all run before one
# check
# ---
# va:  the outcomes, each an `err[Error]`
# ret: the first failure, or ok when every outcome is ok
pub fun first(va: ...) err[Error] {
    $each outcome in va {
        if (sel outcome.err) { ret outcome; }
    }
    ret err[Error].ok{};
}
