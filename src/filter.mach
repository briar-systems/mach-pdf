# the stream filter contract and the filters this library implements
#
# a filter is named in a stream's /Filter entry and, when it can encode,
# turns the bytes a caller gave into the bytes the file holds. a stream lists
# its filters in decode order, as /Filter does, so the writer encodes through
# them last to first. a filter with no encoder can still be named over data the
# caller encoded itself, such as a jpeg under DCTDecode.

use std.allocator;
use std.collections.vector;
use std.compress.deflate;
use std.system.capability;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use pdf.error;

# encode len bytes at input, appending the result to output
#
# the encoder must be deterministic: the same ctx and input give the same
# bytes on every host. a codec failure is reported as `codec` with the
# filter's own code.
# ---
# ctx:    the filter's state
# input:  the bytes to encode
# len:    the count of input bytes
# output: the vector to append the encoded bytes to
# ret:    ok, or why encoding failed
pub def Encode: fun(ptr, *u8, usize, *vector.Vector[u8]) err[error.Error];

# a stream filter
# ---
# name:   the filter's pdf name without the slash, such as "FlateDecode"
# ctx:    state passed to encode
# encode: the encoder, nil when the filter only names data already encoded
pub rec Filter {
    name:   str;
    ctx:    ptr;
    encode: Encode;
}

val HEX: str = "0123456789ABCDEF";

fun ascii_hex_encode(ctx: ptr, input: *u8, len: usize, output: *vector.Vector[u8]) err[error.Error] {
    val room: res[usize, allocator.Error] = vector.reserve[u8](output, len * 2 + 1);
    if (sel room.err) { ret err[error.Error].err{error.from_allocator(room.err)}; }
    var i: usize = 0;
    for (i < len) {
        output.data[output.len]     = HEX[(input[i] >> 4)::usize];
        output.data[output.len + 1] = HEX[(input[i] & 0x0f)::usize];
        output.len                  = output.len + 2;
        i                           = i + 1;
    }
    output.data[output.len] = '>';
    output.len              = output.len + 1;
    ret err[error.Error].ok{};
}

# the ASCIIHexDecode filter, uppercase digits with no whitespace
# ---
# ret: the filter
pub fun ascii_hex() Filter {
    ret Filter{name: "ASCIIHexDecode", ctx: nil, encode: ascii_hex_encode};
}

# the deflate level every FlateDecode stream is written at
#
# zlib's default balance of size and speed. it is fixed so the same objects
# give the same bytes from every caller and on every host.
pub val FLATE_LEVEL: u8 = 6;

fun flate_failure(cause: deflate.DeflateError) err[error.Error] {
    if (sel cause.alloc) { ret err[error.Error].err{error.from_allocator(cause.alloc)}; }
    var code: i64 = 0;
    if (sel cause.level)     { code = 1; }
    or (sel cause.container) { code = 2; }
    or (sel cause.full)      { code = 3; }
    or (sel cause.closed)    { code = 4; }
    or (sel cause.finished)  { code = 5; }
    ret err[error.Error].err{error.Error.codec{code}};
}

# the compressor's scratch comes from output's allocator, and the stream goes
# straight into output, which bound sizes exactly enough
fun flate_encode(ctx: ptr, input: *u8, len: usize, output: *vector.Vector[u8]) err[error.Error] {
    val most: usize                       = deflate.bound(len, deflate.ZLIB);
    val room: res[usize, allocator.Error] = vector.reserve[u8](output, most);
    if (sel room.err) { ret err[error.Error].err{error.from_allocator(room.err)}; }
    val packed: res[usize, deflate.DeflateError] = deflate.compress_into(output.a, FLATE_LEVEL, deflate.ZLIB,
        input, len, ?output.data[output.len], most);
    if (sel packed.err) { ret flate_failure(packed.err); }
    output.len = output.len + packed.ok;
    ret err[error.Error].ok{};
}

# the FlateDecode filter, a zlib stream at FLATE_LEVEL
# ---
# ret: the filter
pub fun flate() Filter {
    ret Filter{name: "FlateDecode", ctx: nil, encode: flate_encode};
}

$if (capability.HOSTED) {
    use std.allocator.page;
    use std.compress.inflate;
    use std.compress.zlib;
    use std.memory;

    test ascii_hex__encodes_uppercase_pairs_and_terminates {
        var a: allocator.Allocator;
        page.make(?a);
        var output: vector.Vector[u8] = vector.init[u8](?a);
        fin { vector.dnit[u8](?output); }
        var input:   [3]u8            = [3]u8{0x00, 0x9f, 'z'};
        val filter:  Filter           = ascii_hex();
        val encoded: err[error.Error] = filter.encode(filter.ctx, ?input[0], 3, ?output);
        if (sel encoded.err)                                        { ret 1; }
        if (output.len != 7)                                        { ret 2; }
        if (!memory.raw_equal(output.data::ptr, "009F7A>"::ptr, 7)) { ret 3; }
        ret 0;
    }

    test flate__writes_a_zlib_stream_that_inflates_to_the_input {
        var a: allocator.Allocator;
        page.make(?a);
        var output: vector.Vector[u8] = vector.init[u8](?a);
        fin { vector.dnit[u8](?output); }
        var input: [64]u8;
        val word:  str   = "stream ";
        var i:     usize = 0;
        for (i < 64) {
            input[i] = word[i % 7];
            i        = i + 1;
        }
        val filter:  Filter           = flate();
        val encoded: err[error.Error] = filter.encode(filter.ctx, ?input[0], 64, ?output);
        if (sel encoded.err)                    { ret 1; }
        if (output.len < 7 || output.len >= 64) { ret 2; }
        if (output.data[0] != 0x78)             { ret 3; }
        var back:     [64]u8;
        val inflated: res[usize, inflate.InflateError] = zlib.decompress_into(?a, output.data, output.len, ?back[0], 64);
        if (sel inflated.err)                                         { ret 4; }
        if (inflated.ok != 64)                                        { ret 5; }
        if (!memory.raw_equal((?back[0])::ptr, (?input[0])::ptr, 64)) { ret 6; }
        ret 0;
    }
}
