# the sample documents, byte for byte, the writer sample in both
# cross-reference forms
#
# regenerate the files with demo/sample and demo/fields after a deliberate
# change to the output, and check them with qpdf and the renderers before
# committing.

use std.allocator;
use std.allocator.page;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;

use pdf.document;
use pdf.error;
use pdf.output;
use pdf.test.fields;
use pdf.test.sample;

#[embed("golden/table.pdf")]
val TABLE: [_]u8;

#[embed("golden/stream.pdf")]
val STREAM: [_]u8;

#[embed("golden/fields.pdf")]
val FIELDS: [_]u8;

fun matches(xref_stream: bool, expected: *u8, len: usize) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    var doc:     document.Document;
    val started: err[error.Error] = document.init(?doc, ?a);
    if (sel started.err) { ret 1; }
    fin { document.dnit(?doc); }
    doc.xref_stream = xref_stream;
    var out: output.Output = output.init(?a);
    fin { output.dnit(?out); }
    val built: err[error.Error] = sample.build(?doc);
    if (sel built.err) { ret 2; }
    val saved: err[error.Error] = document.save(?doc, ?out);
    if (sel saved.err) { ret 3; }
    val updated: err[error.Error] = sample.update(?doc, ?out);
    if (sel updated.err)                                               { ret 4; }
    if (output.offset(?out) != len)                                    { ret 5; }
    if (!memory.raw_equal(output.data(?out)::ptr, expected::ptr, len)) { ret 6; }
    ret 0;
}

test sample__table_matches_golden {
    ret matches(false, ?TABLE[0], $length_of(TABLE));
}

test sample__stream_matches_golden {
    ret matches(true, ?STREAM[0], $length_of(STREAM));
}

test fields__matches_golden {
    var a: allocator.Allocator;
    page.make(?a);
    var doc:     document.Document;
    val started: err[error.Error] = document.init(?doc, ?a);
    if (sel started.err) { ret 1; }
    fin { document.dnit(?doc); }
    var out: output.Output = output.init(?a);
    fin { output.dnit(?out); }
    val built: err[error.Error] = fields.build(?doc);
    if (sel built.err) { ret 2; }
    val saved: err[error.Error] = document.save(?doc, ?out);
    if (sel saved.err)                                                                    { ret 3; }
    if (output.offset(?out) != $length_of(FIELDS))                                        { ret 4; }
    if (!memory.raw_equal(output.data(?out)::ptr, (?FIELDS[0])::ptr, $length_of(FIELDS))) { ret 5; }
    ret 0;
}
