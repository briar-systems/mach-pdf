# signing and verifying: the signed samples byte for byte, each verified, a
# byte changed after signing caught, an update the document does not permit
# flagged, a file pyhanko signed, filled and countersigned verified, a p-384
# key signing with sha-256 verified, and a change to a field a signature locks
# flagged, the update okular signs a second field with allowed, and briar's
# okular-signed contract, whose cms is ber, verified under the document signing purpose

use std.allocator;
use std.allocator.page;
use std.chrono.time;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use pdf.document;
use pdf.error;
use pdf.form;
use pdf.object;
use pdf.output;
use pdf.reader;
use pdf.sign;
use pdf.test.signed;
use pdf.verify;

#[embed("golden/signed.pdf")]
val SIGNED: [_]u8;

#[embed("golden/countersigned.pdf")]
val COUNTERSIGNED: [_]u8;

#[embed("fixtures/pyhanko/signed.pdf")]
val PYHANKO: [_]u8;

#[embed("fixtures/okular/signed.pdf")]
val OKULAR: [_]u8;

#[embed("fixtures/p384/signed.pdf")]
val P384: [_]u8;

#[embed("fixtures/p384/root.der")]
val P384_ROOT: [_]u8;

#[embed("fixtures/briar-ipa/signed.pdf")]
val IPA: [_]u8;

#[embed("fixtures/briar-ipa/root.der")]
val IPA_ROOT: [_]u8;

fun made_matches(a: *allocator.Allocator, make: fun(*allocator.Allocator, *output.Output) err[sign.Error], expected: *u8, len: usize) bool {
    var out: output.Output = output.init(a);
    fin { output.dnit(?out); }
    val made: err[sign.Error] = make(a, ?out);
    if (sel made.err)               { ret false; }
    if (output.offset(?out) != len) { ret false; }
    ret memory.raw_equal(output.data(?out)::ptr, expected::ptr, len);
}

# verify data, expecting count signatures
fun verified(a: *allocator.Allocator, data: *u8, len: usize, report: *verify.Report) bool {
    var trust:   signed.Trust;
    var options: verify.Options   = signed.options(?trust);
    val checked: err[error.Error] = verify.verify(a, data, len, ?options, report);
    ret !sel checked.err;
}

test signed__matches_golden_and_verifies {
    var a: allocator.Allocator;
    page.make(?a);
    if (!made_matches(?a, signed.signed, ?SIGNED[0], $length_of(SIGNED))) { ret 1; }
    var report: verify.Report;
    fin { verify.release(?report); }
    if (!verified(?a, ?SIGNED[0], $length_of(SIGNED), ?report)) { ret 2; }
    if (report.signatures.len != 1 || report.updates.len != 1)  { ret 3; }
    val s: *verify.Signature = ?report.signatures.data[0];
    if (!verify.valid(s) || !s.whole || s.revision != 1)                                         { ret 4; }
    if (s.name_len != 9 || !memory.raw_equal(verify.name(?report, s)::ptr, "signature"::ptr, 9)) { ret 5; }

    # a signed field is not signed again
    var key: signed.Key;
    if (!signed.signer(?key)) { ret 6; }
    fin { signed.close(?key); }
    var out: output.Output = output.init(?a);
    fin { output.dnit(?out); }
    val again: err[sign.Error] = signed.sign_file(?a, ?SIGNED[0], $length_of(SIGNED), "signature", ?key, ?out);
    if (!sel again.err) { ret 7; }
    val cause: sign.Error = again.err;
    if (!sel cause.pdf) { ret 7; }
    val inner: error.Error = cause.pdf;
    if (!sel inner.invalid) { ret 7; }
    ret 0;
}

test countersigned__both_signatures_verify {
    var a: allocator.Allocator;
    page.make(?a);
    if (!made_matches(?a, signed.countersigned, ?COUNTERSIGNED[0], $length_of(COUNTERSIGNED))) { ret 1; }
    var report: verify.Report;
    fin { verify.release(?report); }
    if (!verified(?a, ?COUNTERSIGNED[0], $length_of(COUNTERSIGNED), ?report)) { ret 2; }
    if (report.signatures.len != 2 || report.updates.len != 2)                { ret 3; }
    val author:  *verify.Signature = ?report.signatures.data[0];
    val witness: *verify.Signature = ?report.signatures.data[1];
    if (!verify.valid(author) || author.whole || author.revision != 1) { ret 4; }
    if (!verify.valid(witness) || !witness.whole)                      { ret 5; }
    if (!report.updates.data[1].allowed)                               { ret 6; }
    ret 0;
}

test verify__flags_a_byte_changed_after_signing {
    var a: allocator.Allocator;
    page.make(?a);
    val len:    usize                     = $length_of(SIGNED);
    val copied: res[*u8, allocator.Error] = allocator.allocate[u8](?a, len);
    if (sel copied.err) { ret 1; }
    fin { allocator.deallocate[u8](?a, copied.ok, len); }
    memory.copy[u8](copied.ok, ?SIGNED[0], len);
    # a letter of the first tooltip, inside the signed range, so the file still reads
    var at: usize = 0;
    for (at + 7 < len && !memory.raw_equal((?copied.ok[at])::ptr, "(Owner "::ptr, 7)) { at = at + 1; }
    if (at + 7 >= len) { ret 2; }
    copied.ok[at + 1] = 'N';
    var report: verify.Report;
    fin { verify.release(?report); }
    if (!verified(?a, copied.ok, len, ?report)) { ret 3; }
    if (report.signatures.len != 1)             { ret 4; }
    val s: *verify.Signature = ?report.signatures.data[0];
    if (!s.covered || s.cms.error == 0 || verify.valid(s)) { ret 5; }
    ret 0;
}

test verify__flags_an_update_the_document_does_not_permit {
    var a: allocator.Allocator;
    page.make(?a);
    var doc:     document.Document;
    val started: err[error.Error] = document.init(?doc, ?a);
    if (sel started.err) { ret 1; }
    fin { document.dnit(?doc); }
    val read: err[error.Error] = reader.read(?doc, ?SIGNED[0], $length_of(SIGNED), reader.defaults());
    if (sel read.err) { ret 2; }
    var out: output.Output = output.init(?a);
    fin { output.dnit(?out); }
    output.put(?out, ?SIGNED[0], $length_of(SIGNED));
    val root: res[*object.Dict, error.Error] = document.catalog(?doc);
    if (sel root.err)       { ret 3; }
    if (!sel doc.root.some) { ret 3; }
    val catalog: object.Ref                      = doc.root.some;
    val lang:    res[object.Object, error.Error] = object.text(document.objects(?doc), "fr");
    if (sel lang.err) { ret 4; }
    val changed: err[error.Error] = error.first(object.set(root.ok, "Lang", lang.ok),
        document.touch(?doc, catalog), document.append(?doc, ?out));
    if (sel changed.err) { ret 5; }

    var report: verify.Report;
    fin { verify.release(?report); }
    if (!verified(?a, output.data(?out), output.offset(?out), ?report)) { ret 6; }
    if (report.signatures.len != 1 || report.updates.len != 2)          { ret 7; }
    val s: *verify.Signature = ?report.signatures.data[0];
    if (!s.covered || s.cms.error != 0 || s.allowed || verify.valid(s)) { ret 8; }
    val update: verify.Update = report.updates.data[1];
    if (update.allowed || update.offender != catalog.number) { ret 9; }
    ret 0;
}

fun named(report: *verify.Report, s: *verify.Signature, name: str, len: usize) bool {
    ret s.name_len == len && memory.raw_equal(verify.name(report, s)::ptr, name::ptr, len);
}

test pyhanko__signed_filled_and_countersigned_verifies {
    var a: allocator.Allocator;
    page.make(?a);
    var report: verify.Report;
    fin { verify.release(?report); }
    if (!verified(?a, ?PYHANKO[0], $length_of(PYHANKO), ?report)) { ret 1; }
    if (report.signatures.len != 2 || report.updates.len != 3)    { ret 2; }
    if (report.permission != 2)                                   { ret 3; }
    val author:  *verify.Signature = ?report.signatures.data[0];
    val witness: *verify.Signature = ?report.signatures.data[1];
    if (!named(?report, author, "author", 6) || !named(?report, witness, "witness", 7)) { ret 4; }
    if (!verify.valid(author) || author.revision != 1 || !author.locked)                { ret 5; }
    if (!verify.valid(witness) || !witness.whole || !witness.locked)                    { ret 6; }
    var u: usize = 0;
    for (u < report.updates.len) {
        if (!report.updates.data[u].allowed) { ret 7; }
        u = u + 1;
    }
    # filling rewrote the remark field's value and appearance stream
    val fill: verify.Update = report.updates.data[1];
    if (fill.needs != 2 || fill.changes_len != 1) { ret 8; }
    val change: *verify.Change = ?report.changes.data[fill.changes_at];
    if (change.name_len != 6 || !memory.raw_equal(verify.change_name(?report, change)::ptr, "remark"::ptr, 6)) { ret 9; }
    ret 0;
}

test verify__flags_a_change_to_a_locked_field {
    var a: allocator.Allocator;
    page.make(?a);
    var doc:     document.Document;
    val started: err[error.Error] = document.init(?doc, ?a);
    if (sel started.err) { ret 1; }
    fin { document.dnit(?doc); }
    val read: err[error.Error] = reader.read(?doc, ?PYHANKO[0], $length_of(PYHANKO), reader.defaults());
    if (sel read.err) { ret 2; }
    var out: output.Output = output.init(?a);
    fin { output.dnit(?out); }
    output.put(?out, ?PYHANKO[0], $length_of(PYHANKO));

    # the remark field, which the witness locks, filled again, its appearance stream rewritten in place
    val remark: res[form.Found, error.Error] = form.find(?doc, document.objects(?doc), "remark");
    if (sel remark.err) { ret 3; }
    val shown: opt[*object.Object] = object.get(remark.ok.dict, "AP");
    if (!sel shown.some) { ret 4; }
    val held: object.Object = @shown.some;
    if (!sel held.dict) { ret 4; }
    val normal: opt[*object.Object] = object.get(held.dict, "N");
    if (!sel normal.some) { ret 4; }
    val target: object.Object = @normal.some;
    if (!sel target.reference) { ret 4; }
    val old: res[object.Object, error.Error] = document.deref(?doc, target);
    if (sel old.err) { ret 5; }
    val was: object.Object = old.ok;
    if (!sel was.stream) { ret 5; }
    val made: res[*object.Stream, error.Error] = object.stream(document.objects(?doc));
    if (sel made.err) { ret 6; }
    var keys: [4]str = [4]str{"Type", "Subtype", "BBox", "Resources"};
    var k:    usize  = 0;
    for (k < 4) {
        val kept: opt[*object.Object] = object.get(was.stream.dict, keys[k]);
        if (!sel kept.some) { ret 6; }
        val set: err[error.Error] = object.set(made.ok.dict, keys[k], @kept.some);
        if (sel set.err) { ret 6; }
        k = k + 1;
    }
    val drawn: str                             = "/Tx BMC q BT /F1 12 Tf 0 g 2 6 Td (Rejected) Tj ET Q EMC";
    val value: res[object.Object, error.Error] = object.text(document.objects(?doc), "Rejected");
    if (sel value.err) { ret 7; }
    val changed: err[error.Error] = error.first(object.write(made.ok, drawn, 56),
        document.define(?doc, target.reference, object.Object.stream{made.ok}),
        object.set(remark.ok.dict, "V", value.ok), document.touch(?doc, remark.ok.node));
    if (sel changed.err) { ret 8; }
    val appended: err[error.Error] = document.append(?doc, ?out);
    if (sel appended.err) { ret 8; }

    var report: verify.Report;
    fin { verify.release(?report); }
    if (!verified(?a, output.data(?out), output.offset(?out), ?report)) { ret 9; }
    if (report.signatures.len != 2 || report.updates.len != 4)          { ret 10; }
    # the document permits filling, and the author's lock leaves the remark field out
    val update: verify.Update = report.updates.data[3];
    if (!update.allowed || update.needs != 2 || update.changes_len != 1) { ret 11; }
    val author: *verify.Signature = ?report.signatures.data[0];
    if (!verify.valid(author) || !author.lock_kept) { ret 12; }
    val witness: *verify.Signature = ?report.signatures.data[1];
    if (witness.cms.error != 0 || witness.lock_kept || witness.allowed || verify.valid(witness)) { ret 13; }
    ret 0;
}

# a p-384 key signing with sha-256, as okular does from a yubikey
test verify__accepts_a_p384_key_signing_sha256 {
    var a: allocator.Allocator;
    page.make(?a);
    var trust:   signed.Trust;
    var options: verify.Options = signed.trusting(?trust, ?P384_ROOT[0], $length_of(P384_ROOT));
    var report:  verify.Report;
    fin { verify.release(?report); }
    val checked: err[error.Error] = verify.verify(?a, ?P384[0], $length_of(P384), ?options, ?report);
    if (sel checked.err)            { ret 1; }
    if (report.signatures.len != 1) { ret 2; }
    val s: *verify.Signature = ?report.signatures.data[0];
    if (!verify.valid(s) || !s.whole) { ret 3; }

    # a letter of the field's name, inside the signed range, so the file still reads
    val len:    usize                     = $length_of(P384);
    val copied: res[*u8, allocator.Error] = allocator.allocate[u8](?a, len);
    if (sel copied.err) { ret 4; }
    fin { allocator.deallocate[u8](?a, copied.ok, len); }
    memory.copy[u8](copied.ok, ?P384[0], len);
    var at: usize = 0;
    for (at + 11 < len && !memory.raw_equal((?copied.ok[at])::ptr, "(signature)"::ptr, 11)) { at = at + 1; }
    if (at + 11 >= len) { ret 5; }
    copied.ok[at + 1] = 'S';
    var changed: verify.Report;
    fin { verify.release(?changed); }
    val again: err[error.Error] = verify.verify(?a, copied.ok, len, ?options, ?changed);
    if (sel again.err)               { ret 6; }
    if (changed.signatures.len != 1) { ret 7; }
    val t: *verify.Signature = ?changed.signatures.data[0];
    if (!t.covered || t.cms.error == 0 || verify.valid(t)) { ret 8; }
    ret 0;
}

# the update okular signs a second field with rewrites the field's widget, which the first signature allows
test verify__allows_the_update_that_signs_a_second_field {
    var report: verify.Report;
    fin { verify.release(?report); }
    var a: allocator.Allocator;
    page.make(?a);
    if (!verified(?a, ?OKULAR[0], $length_of(OKULAR), ?report))                       { ret 1; }
    if (report.signatures.len != 2 || report.updates.len != 2)                        { ret 2; }
    if (!report.updates.data[0].allowed || !report.updates.data[1].allowed)           { ret 3; }
    if (report.updates.data[1].needs != 2 || report.updates.data[1].changes_len != 1) { ret 4; }
    val first: *verify.Signature = ?report.signatures.data[0];
    if (!first.allowed || !first.lock_kept) { ret 5; }
    if (!report.signatures.data[1].allowed) { ret 6; }
    ret 0;
}

# page content rewritten after both signatures refuses both
test verify__flags_page_content_changed_after_okular_signs_twice {
    var a: allocator.Allocator;
    page.make(?a);
    var doc:     document.Document;
    val started: err[error.Error] = document.init(?doc, ?a);
    if (sel started.err) { ret 1; }
    fin { document.dnit(?doc); }
    val read: err[error.Error] = reader.read(?doc, ?OKULAR[0], $length_of(OKULAR), reader.defaults());
    if (sel read.err) { ret 2; }
    var out: output.Output = output.init(?a);
    fin { output.dnit(?out); }
    output.put(?out, ?OKULAR[0], $length_of(OKULAR));
    val content: object.Ref                       = object.Ref{number: 4, generation: 0};
    val made:    res[*object.Stream, error.Error] = object.stream(document.objects(?doc));
    if (sel made.err) { ret 3; }
    val drawn:   str              = "BT /F1 12 Tf 72 700 Td (Forged) Tj ET";
    val changed: err[error.Error] = error.first(object.write(made.ok, drawn, 37),
        document.define(?doc, content, object.Object.stream{made.ok}), document.touch(?doc, content), document.append(?doc, ?out));
    if (sel changed.err) { ret 4; }

    var report: verify.Report;
    fin { verify.release(?report); }
    if (!verified(?a, output.data(?out), output.offset(?out), ?report)) { ret 5; }
    if (report.signatures.len != 2 || report.updates.len != 3)          { ret 6; }
    val update: verify.Update = report.updates.data[2];
    if (update.allowed || update.offender != content.number)                    { ret 7; }
    if (report.signatures.data[0].allowed || report.signatures.data[1].allowed) { ret 8; }
    ret 0;
}

# the two signatures okular wrote, with indefinite lengths in their cms, chain to briar's root
test verify__accepts_the_ber_signatures_okular_writes {
    var a: allocator.Allocator;
    page.make(?a);
    var trust:   signed.Trust;
    var options: verify.Options = signed.trusting(?trust, ?IPA_ROOT[0], $length_of(IPA_ROOT));
    options.chain.now = time.unix(1791100000, 0);
    var report: verify.Report;
    fin { verify.release(?report); }
    val checked: err[error.Error] = verify.verify(?a, ?IPA[0], $length_of(IPA), ?options, ?report);
    if (sel checked.err)                                                                        { ret 1; }
    if (report.signatures.len != 2)                                                             { ret 2; }
    if (!verify.valid(?report.signatures.data[0]) || !verify.valid(?report.signatures.data[1])) { ret 3; }

    # the binary comment after the header, inside both signed ranges
    val len:    usize                     = $length_of(IPA);
    val copied: res[*u8, allocator.Error] = allocator.allocate[u8](?a, len);
    if (sel copied.err) { ret 4; }
    fin { allocator.deallocate[u8](?a, copied.ok, len); }
    memory.copy[u8](copied.ok, ?IPA[0], len);
    copied.ok[11] = copied.ok[11] ^ 1;
    var changed: verify.Report;
    fin { verify.release(?changed); }
    val again: err[error.Error] = verify.verify(?a, copied.ok, len, ?options, ?changed);
    if (sel again.err)                                                                          { ret 5; }
    if (changed.signatures.len != 2)                                                            { ret 6; }
    if (verify.valid(?changed.signatures.data[0]) || verify.valid(?changed.signatures.data[1])) { ret 7; }
    ret 0;
}
