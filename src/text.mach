# text strings (iso 32000-2 section 7.9.2.2)
#
# a text string holds human readable text such as a field's name, tooltip or
# value. text that is all printable ascii, tab, line feed or carriage return is
# written as it is, since PDFDocEncoding spells those bytes the same. anything
# else is written as utf-16be behind a byte order mark, which every pdf reader
# takes.

use std.allocator;
use std.system.capability;
use std.text.utf8;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use pdf.error;
use pdf.object;
use pdf.output;

fun plain(data: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        val c: u8 = data[i];
        if (!((c >= 0x20 && c <= 0x7e) || c == '\t' || c == '\n' || c == '\r')) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun unit(out: *output.Output, value: u32) {
    output.byte(out, ((value >> 8) & 0xff)::u8);
    output.byte(out, (value & 0xff)::u8);
}

# a text string object holding the utf-8 text of len bytes at data
# ---
# a:    the allocator the string lives in
# data: the text as utf-8
# len:  the count of bytes
# ret:  the object, `invalid` for bytes that are not utf-8, or the allocator's
#       refusal
pub fun string(a: *allocator.Allocator, data: *u8, len: usize) res[object.Object, error.Error] {
    if (plain(data, len)) { ret object.string(a, data, len); }
    var out: output.Output = output.init(a);
    fin { output.dnit(?out); }
    unit(?out, 0xfeff);
    var i: usize = 0;
    for (i < len) {
        var cp:   utf8.Codepoint = 0;
        val used: usize          = utf8.decode(?data[i], len - i, ?cp);
        if (used == 0) { ret res[object.Object, error.Error].err{error.Error.invalid{}}; }
        if (cp >= 0x10000) {
            val rest: u32 = cp - 0x10000;
            unit(?out, 0xd800 | (rest >> 10));
            unit(?out, 0xdc00 | (rest & 0x3ff));
        }
        or {
            unit(?out, cp);
        }
        i = i + used;
    }
    val status: err[error.Error] = output.status(?out);
    if (sel status.err) { ret res[object.Object, error.Error].err{status.err}; }
    ret object.hex_string(a, output.data(?out), output.offset(?out));
}

# a text string object holding the utf-8 text of s
# ---
# a:   the allocator the string lives in
# s:   the text as utf-8
# ret: the object, `invalid` for text that is not utf-8, or the allocator's
#      refusal
pub fun of(a: *allocator.Allocator, s: str) res[object.Object, error.Error] {
    ret string(a, s, str_len(s));
}

$if (capability.HOSTED) {
    use std.allocator.page;
    use std.memory;

    test string__keeps_ascii_and_writes_the_rest_as_utf16 {
        var a: allocator.Allocator;
        page.make(?a);
        val ascii: res[object.Object, error.Error] = of(?a, "Name (first)");
        if (!sel ascii.ok) { ret 1; }
        val kept: object.Object = ascii.ok;
        if (!sel kept.string)                         { ret 2; }
        if (kept.string.hex || kept.string.len != 12) { ret 2; }
        # e acute and a musical symbol outside the basic plane
        val wide: res[object.Object, error.Error] = of(?a, "\xc3\xa9\xf0\x9d\x84\x9e");
        if (!sel wide.ok) { ret 3; }
        val coded: object.Object = wide.ok;
        if (!sel coded.string)                          { ret 4; }
        if (!coded.string.hex || coded.string.len != 8) { ret 4; }
        val expected: [8]u8 = [8]u8{0xfe, 0xff, 0x00, 0xe9, 0xd8, 0x34, 0xdd, 0x1e};
        if (!memory.raw_equal(coded.string.data::ptr, (?expected[0])::ptr, 8)) { ret 5; }
        val broken: res[object.Object, error.Error] = of(?a, "\xc3");
        if (!(sel broken.err && sel broken.err.invalid)) { ret 6; }
        ret 0;
    }
}
