# the page tree and the pages in it (iso 32000-2 section 7.7.3)
#
# a tree is one /Pages node the catalog points to, and each page is an
# indirect /Page dictionary under it in the order it was added. a page's
# dictionary is the caller's to extend with entries this module does not set,
# such as /Annots.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use pdf.content;
use pdf.document;
use pdf.error;
use pdf.object;

# a rectangle in default user space, such as a /MediaBox
# ---
# left, bottom: the lower left corner
# right, top:   the upper right corner
pub rec Rect {
    left:   f64;
    bottom: f64;
    right:  f64;
    top:    f64;
}

# a page tree node
# ---
# node:  the /Pages object
# dict:  its dictionary
# kids:  its /Kids array
# count: the pages under it
pub rec Tree {
    node:  object.Ref;
    dict:  *object.Dict;
    kids:  *object.Array;
    count: i64;
}

# a page
# ---
# node: the /Page object
# dict: its dictionary
pub rec Page {
    node: object.Ref;
    dict: *object.Dict;
}

# the a4 media box in points
pub val A4: Rect = Rect{left: 0.0, bottom: 0.0, right: 595.0, top: 842.0};

# the us letter media box in points
pub val LETTER: Rect = Rect{left: 0.0, bottom: 0.0, right: 612.0, top: 792.0};

fun failure[T](cause: error.Error) res[T, error.Error] {
    ret res[T, error.Error].err{cause};
}

# make an empty page tree and set it as the catalog's /Pages
# ---
# doc: the document
# ret: the tree, or why it could not be made
pub fun tree(doc: *document.Document) res[Tree, error.Error] {
    val root: res[*object.Dict, error.Error] = document.catalog(doc);
    if (sel root.err) { ret failure[Tree](root.err); }
    val d: res[*object.Dict, error.Error] = object.dict(document.objects(doc));
    if (sel d.err) { ret failure[Tree](d.err); }
    val kids: res[*object.Array, error.Error] = object.array(document.objects(doc));
    if (sel kids.err) { ret failure[Tree](kids.err); }
    val set: err[error.Error] = error.first(
        object.set_name(d.ok, "Type", "Pages"),
        object.set(d.ok, "Kids", object.Object.array{kids.ok}),
        object.set(d.ok, "Count", object.integer(0)));
    if (sel set.err) { ret failure[Tree](set.err); }
    val node: res[object.Ref, error.Error] = document.add(doc, object.Object.dict{d.ok});
    if (sel node.err) { ret failure[Tree](node.err); }
    val linked: err[error.Error] = object.set(root.ok, "Pages", object.reference(node.ok));
    if (sel linked.err) { ret failure[Tree](linked.err); }
    ret res[Tree, error.Error].ok{Tree{node: node.ok, dict: d.ok, kids: kids.ok, count: 0}};
}

fun box(doc: *document.Document, r: Rect) res[object.Object, error.Error] {
    val list: res[*object.Array, error.Error] = object.array(document.objects(doc));
    if (sel list.err) { ret failure[object.Object](list.err); }
    var corners: [4]f64 = [4]f64{r.left, r.bottom, r.right, r.top};
    var i:       usize  = 0;
    for (i < 4) {
        val decimal: res[object.Real, error.Error] = object.real_of(corners[i], 4);
        if (sel decimal.err) { ret failure[object.Object](decimal.err); }
        val pushed: err[error.Error] = object.push(list.ok, object.real(decimal.ok));
        if (sel pushed.err) { ret failure[object.Object](pushed.err); }
        i = i + 1;
    }
    ret res[object.Object, error.Error].ok{object.Object.array{list.ok}};
}

# add a page with a media box at the end of a tree
# ---
# doc:   the document
# t:     the tree
# media: the page's /MediaBox
# ret:   the page, or why it could not be added
pub fun add(doc: *document.Document, t: *Tree, media: Rect) res[Page, error.Error] {
    val d: res[*object.Dict, error.Error] = object.dict(document.objects(doc));
    if (sel d.err) { ret failure[Page](d.err); }
    val mediabox: res[object.Object, error.Error] = box(doc, media);
    if (sel mediabox.err) { ret failure[Page](mediabox.err); }
    val set: err[error.Error] = error.first(
        object.set_name(d.ok, "Type", "Page"),
        object.set(d.ok, "Parent", object.reference(t.node)),
        object.set(d.ok, "MediaBox", mediabox.ok));
    if (sel set.err) { ret failure[Page](set.err); }
    val node: res[object.Ref, error.Error] = document.add(doc, object.Object.dict{d.ok});
    if (sel node.err) { ret failure[Page](node.err); }
    val listed: err[error.Error] = object.push(t.kids, object.reference(node.ok));
    if (sel listed.err) { ret failure[Page](listed.err); }
    t.count = t.count + 1;
    val counted: err[error.Error] = object.set(t.dict, "Count", object.integer(t.count));
    if (sel counted.err) { ret failure[Page](counted.err); }
    ret res[Page, error.Error].ok{Page{node: node.ok, dict: d.ok}};
}

# give a page a new content stream and start writing operators into it
#
# the stream becomes the page's /Contents. content.finish completes it.
# ---
# doc: the document
# p:   the page
# ret: the builder, or why the stream could not be made
pub fun contents(doc: *document.Document, p: *Page) res[content.Builder, error.Error] {
    val s: res[*object.Stream, error.Error] = object.stream(document.objects(doc));
    if (sel s.err) { ret failure[content.Builder](s.err); }
    val node: res[object.Ref, error.Error] = document.add(doc, object.Object.stream{s.ok});
    if (sel node.err) { ret failure[content.Builder](node.err); }
    val set: err[error.Error] = object.set(p.dict, "Contents", object.reference(node.ok));
    if (sel set.err) { ret failure[content.Builder](set.err); }
    ret res[content.Builder, error.Error].ok{content.begin(s.ok)};
}

# the dictionary under key in d, made on first use
fun child(doc: *document.Document, d: *object.Dict, key: str) res[*object.Dict, error.Error] {
    val held: opt[*object.Object] = object.get(d, key);
    if (sel held.some) {
        val value: object.Object = @held.some;
        if (sel value.dict) { ret res[*object.Dict, error.Error].ok{value.dict}; }
        ret failure[*object.Dict](error.Error.invalid{});
    }
    val made: res[*object.Dict, error.Error] = object.dict(document.objects(doc));
    if (sel made.err) { ret made; }
    val set: err[error.Error] = object.set(d, key, object.Object.dict{made.ok});
    if (sel set.err) { ret failure[*object.Dict](set.err); }
    ret made;
}

# make a font available to a page's content under a resource name
# ---
# doc:  the document
# p:    the page
# name: the resource name content.font selects it by, without its slash
# font: the font dictionary
# ret:  ok, `invalid` when the page's /Resources or /Font is not a direct
#       dictionary, or the allocator's refusal
pub fun use_font(doc: *document.Document, p: *Page, name: str, font: object.Ref) err[error.Error] {
    val resources: res[*object.Dict, error.Error] = child(doc, p.dict, "Resources");
    if (sel resources.err) { ret err[error.Error].err{resources.err}; }
    val fonts: res[*object.Dict, error.Error] = child(doc, resources.ok, "Font");
    if (sel fonts.err) { ret err[error.Error].err{fonts.err}; }
    ret object.set(fonts.ok, name, object.reference(font));
}
