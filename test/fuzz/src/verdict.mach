# what a boundary answers for one input
#
# an input is answered when the entry point reads it or refuses it with a
# typed error, without a fault and within its bounds. a finding is an answer
# that broke an invariant. outcome names which answer it was, so two inputs
# with the same outcome reached the same verdict, and mutation retains an input
# only for an outcome the corpus does not hold yet

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

pub rec Verdict {
    finding: bool;
    outcome: u64;
    detail:  str;
}

# how many reads the current input got accepted by, which the driver resets
# before each answer and reports beside it
var accepts: usize;

pub fun reset() {
    accepts = 0;
}

pub fun accept() {
    accepts = accepts + 1;
}

pub fun accepted() usize {
    ret accepts;
}

pub fun answered(outcome: u64) Verdict {
    ret Verdict{finding: false, outcome: outcome, detail: ""};
}

pub fun violated(detail: str) Verdict {
    ret Verdict{finding: true, outcome: 0, detail: detail};
}

# fold one more observation into an outcome
pub fun mix(outcome: u64, value: u64) u64 {
    ret (outcome ^ value) * 0x100000001b3;
}

# a count as none, one, two, or several, so a longer run of the same shape is
# not a new outcome
pub fun bucket(count: usize) u64 {
    if (count > 3) { ret 3; }
    ret count::u64;
}
